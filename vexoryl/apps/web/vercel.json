{
  "rewrites": [{ "source": "/health", "destination": "/health.json" }],
  "headers": [
    {
      "source": "/health",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}